<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enrutar todas las peticiones /api/* al backend PHP + MySQL
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Servir archivos y carpetas reales directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Rutas dinámicas de confirmación de pedidos y comprobantes
  RewriteRule ^pedido/[^/]+/exito/?$ /pedido/new/exito/index.html [L]
  RewriteRule ^cuenta/pedidos/[^/]+/comprobante/?$ /cuenta/pedidos/detalle/comprobante/index.html [L]

  # 4. Soporte para rutas limpias sin extensión .html (Next.js Static Export)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>
