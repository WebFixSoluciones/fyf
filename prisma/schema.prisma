datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

enum Role {
  ADMIN
  COLABORADOR
  CLIENTE
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  PAYPHONE_CARD
  WHATSAPP_ORDER
  TRANSFERENCIA_DIRECTA
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  passwordHash  String
  name          String
  phone         String?
  idNumber      String?   // Cédula o RUC
  role          Role      @default(CLIENTE)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  addresses     Address[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient    String
  idNumber     String   // Cédula o RUC
  phone        String
  province     String
  city         String
  street       String   @db.Text
  reference    String?  @db.Text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  order       Int       @default(0)
  products    Product[]
}

model Product {
  id              String                @id @default(cuid())
  sku             String                @unique
  name            String
  slug            String                @unique
  description     String                @db.Text
  material        String?
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id])
  mainImage       String
  images          Json?                 // Array JSON de URLs de galería compatible con MySQL
  hasLogoOption   Boolean               @default(false)
  logoPriceExtra  Decimal               @default(0.20) @db.Decimal(10, 2)
  allowCustomSize Boolean               @default(false)
  isActive        Boolean               @default(true)
  variants        ProductVariant[]
  interactions    WhatsAppInteraction[]
  orderItems      OrderItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code           String?
  sizeLabel      String
  shape          String?
  color          String?
  unitPrice      Decimal @db.Decimal(10, 2)
  dozenPrice     Decimal @db.Decimal(10, 2)
  wholesalePrice Decimal @db.Decimal(10, 2)
  stock          Int     @default(999)
  isActive       Boolean @default(true)
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique // Ej: FYF-2026-1001
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String
  customerIdNumber      String            // Cédula o RUC
  customerEmail         String
  customerPhone         String
  shippingAddress       String            @db.Text
  shippingCity          String
  shippingProvince      String
  shippingReference     String?           @db.Text
  shippingMethod        String            @default("domicilio")
  paymentMethod         PaymentMethod
  paymentStatus         String            @default("PENDING") // PENDING, APPROVED, REJECTED
  payphoneTransactionId String?
  orderStatus           OrderStatus       @default(PENDIENTE)
  subtotal              Decimal           @db.Decimal(10, 2)
  shippingCost          Decimal           @default(0.00) @db.Decimal(10, 2)
  total                 Decimal           @db.Decimal(10, 2)
  notes                 String?           @db.Text
  items                 OrderItem[]
  tracking              ShippingTracking?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String   @default("Producto FYF Uniformes")
  variantDetails Json     // { size, shape, color, customDimensions, withLogo }
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
}

model ShippingTracking {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String    // Ej: "Servientrega", "LaarCourier", "Entrega Local"
  trackingNumber String
  trackingUrl    String?
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?
  notes          String?   @db.Text
}

model WhatsAppInteraction {
  id              String   @id @default(cuid())
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantDetails  Json
  calculatedPrice Decimal  @db.Decimal(10, 2)
  quantity        Int
  createdAt       DateTime @default(now())
}

model StoreSettings {
  id                    String   @id @default("default")
  whatsappPrimary       String   @default("593993358701")
  whatsappSecondary     String   @default("593988742584")
  whatsappActiveNumber  String   @default("593993358701")
  whatsappTemplate      String   @default("Hola FYF Uniformes, deseo realizar una cotización/pedido: *{orderNumber}*...") @db.VarChar(500)
  payphoneClientId      String?
  payphoneAppId         String?
  payphoneToken         String?  @db.Text
  payphoneIsSandbox     Boolean  @default(true)
  shippingBasePichincha Decimal  @default(3.50) @db.Decimal(10, 2)
  shippingBaseNational  Decimal  @default(5.50) @db.Decimal(10, 2)
  promotionsJson        Json?
  updatedAt             DateTime @updatedAt
}
