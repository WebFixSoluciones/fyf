# Base de datos MySQL en cPanel
# Reemplaza usuario_cpanel, password_bd y nombre_bd con los datos creados en "MySQL® Databases" de cPanel
DATABASE_URL="mysql://usuario_cpanel:password_bd@localhost:3306/nombre_bd"

# Almacenamiento de archivos (En cPanel se guardan automáticamente en /public/uploads)
BLOB_READ_WRITE_TOKEN=""

# Payphone Ecuador API v3
PAYPHONE_APP_ID="tu_app_id"
PAYPHONE_CLIENT_ID="tu_client_id"
PAYPHONE_TOKEN="tu_token_payphone"
PAYPHONE_IS_SANDBOX="false"

# Secretos de Sesión y Autenticación Admin
AUTH_SECRET="fyf-store-super-secret-jwt-key-2026"
ADMIN_PASSWORD_DEFAULT="FyfAdmin2026*"

# Tienda y Dominio en Producción
NEXT_PUBLIC_APP_URL="https://www.fyf.com.ec"
NEXT_PUBLIC_WHATSAPP_NUMBER="593993358701"
